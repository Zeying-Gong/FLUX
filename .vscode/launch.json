    "version": "0.2.0",
    "configurations": [
        {
            "name": "FLUX Checkpoints Server",  // 调试配置名称（自定义）
            "type": "debugpy",                 // 调试类型（固定为python）
            "request": "launch",              // 启动方式（launch/attach）
            "program": "${workspaceFolder}/baselines/cfm_rf/cfm_rf_server.py",  // 脚本绝对路径（关键）
            "args": [                         // 命令行参数（对应--scene_dir）
                "--port",
                "9999",
            ],
            "cwd": "${workspaceFolder}",      // 运行工作目录（脚本所在的根目录）
            "python": "/home/zeyingg/anaconda3/envs/navdp/bin/python",
            "env": {                          // 可选：指定运行环境（如conda环境）
                "DISPLAY": ":0",
                "CUDA_VISIBLE_DEVICES": "3",
            }, 
            "justMyCode": false,                // 调试第三方库（如IsaacLab）时设为false
            "console": "integratedTerminal"     // 输出到VS Code集成终端
        },
        {
            "name": "Navdp Checkpoints Server",  // 调试配置名称（自定义）
            "type": "debugpy",                 // 调试类型（固定为python）
            "request": "launch",              // 启动方式（launch/attach）
            "program": "${workspaceFolder}/baselines/navdp/navdp_server.py",  // 脚本绝对路径（关键）
            "args": [                         // 命令行参数（对应--scene_dir）
                "--port",
                "9999",
            ],
            "cwd": "${workspaceFolder}",      // 运行工作目录（脚本所在的根目录）
            "python": "/home/zeyingg/anaconda3/envs/navdp/bin/python",
            "env": {                          // 可选：指定运行环境（如conda环境）
                "DISPLAY": ":0",
                "CUDA_VISIBLE_DEVICES": "3",
            },
            "justMyCode": false,                // 调试第三方库（如IsaacLab）时设为false
            "console": "integratedTerminal"     // 输出到VS Code集成终端
        },
    ]
}