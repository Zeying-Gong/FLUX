#usda 1.0
(defaultPrim = "World"
 metersPerUnit = 1
 upAxis = "Z")
def Xform "World" {
 over "gauss" (prepend references = @/data/nas_ray/dataset/worlds/assets/sage-3d/InteriorGS_usdz/840115.usdz[gauss.usda]@) {
  double3 xformOp:rotateXYZ = (-90, 0, 0)
  uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
 }
 def Xform "scene_collision" (prepend payload = @/data/nas_ray/dataset/worlds/assets/sage-3d/Collision_Mesh/840115/840115_collision.usd@) {
  quatf xformOp:orient = (0, 0, 0, 1)
  uniform token[] xformOpOrder = ["xformOp:orient"]
  token visibility = "invisible"
 }
}
